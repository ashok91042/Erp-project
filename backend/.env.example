# ---- Database (required) -------------------------------------------------
# Supabase Postgres. Use the TRANSACTION pooler (port 6543) — it is safe for
# serverless/concurrent connections. Project Settings → Database → Connection
# string → "URI".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Auth (required) -----------------------------------------------------
# Signs the session JWTs returned by POST /api/auth/login. Login fails closed
# with 503 if neither this nor SUPABASE_JWT_SECRET is set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=
# Optional: only if you also accept Supabase-issued tokens.
SUPABASE_JWT_SECRET=
# Token lifetime (any jsonwebtoken/vercel-style duration string).
APP_JWT_EXPIRES=8h

# ---- Server --------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Comma-separated exact origins. Unset = allow all. Localhost/127.0.0.1 are
# always allowed so the dev client works regardless.
CORS_ORIGIN=https://your-app.vercel.app
# MUST be "false" in production. When true (or when NODE_ENV != production)
# the API honours x-demo-email / x-demo-role headers, which lets anyone
# impersonate a principal.
ALLOW_DEMO_HEADERS=false

# ---- Email (optional) ----------------------------------------------------
# Omit ALL of these to log alerts to the console instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Academic ERP <no-reply@yourdomain.com>"
# Fallback recipient when a student has no parent_email on record.
NOTIFY_EMAIL=

# ---- Rate limits (optional; defaults shown) -------------------------------
RL_LOGIN_MAX=10
RL_LOGIN_WINDOW_MS=900000
RL_GLOBAL_MAX=300
RL_GLOBAL_WINDOW_MS=900000
RL_WRITE_MAX=100
RL_WRITE_WINDOW_MS=900000
RL_REQUESTS_MAX=20
RL_REQUESTS_WINDOW_MS=900000