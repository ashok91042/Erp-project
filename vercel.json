{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend",
      "routes": [
        {
          "src": "/api/backend",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/" }]
        },
        {
          "src": "/api/backend(/.*)",
          "transforms": [{ "type": "request.path", "op": "set", "args": "$1" }]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/backend(/.*)?",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}