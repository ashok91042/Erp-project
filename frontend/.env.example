# Client env (optional). Leave NEXT_PUBLIC_API_BASE empty to use the default:
#   local dev -> ""   (next.config.mjs proxies /api/* to the backend via API_ORIGIN)
#   Vercel    -> ""   (vercel.json routes /api/* to the "backend" service)
# Either way the browser calls the API same-origin, so CORS is never involved.
# Setting it makes the browser call the API directly, which then requires CORS
# on the backend.
NEXT_PUBLIC_API_BASE=

# Server-side only (no NEXT_PUBLIC_ prefix) — the origin the /api/* rewrite
# forwards to during local dev. On Vercel the API is a service in the same
# project, so leave this UNSET: setting it re-enables the Next proxy and
# breaks the platform routing. Only set it if the API is hosted somewhere else
# (e.g. a standalone deployment on Railway).
# API_ORIGIN=https://your-backend.up.railway.app

# ---- Supabase browser keys (optional) ------------------------------------
# Only needed if you replace the mock session with Supabase Auth. The anon key
# is PUBLIC by design (it is shipped in the JS bundle and only grants the
# `anon` role) — it is still restricted by RLS. NEVER put the service_role key
# or DATABASE_URL in a NEXT_PUBLIC_ variable.
# Project URL = https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
